{
  "name": "sweet-carousel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sweet Carousel (甜点转盘) — a small, offline card-drafting game for family game night",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:verify": "node scripts/verify-data.mjs",
    "check": "npm run data:verify && tsc --noEmit && vitest run && vite build",
    "e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/shots.mjs",
    "ai:calibrate": "vite-node scripts/ai-calibration.ts",
    "lan": "node ../../tools/lan-server.mjs --dist dist --port 8080",
    "tauri": "tauri"
  },
  "dependencies": {
    "@family-arcade/lan": "file:../../packages/lan",
    "@tauri-apps/api": "^2.12.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
