  "lines": [
    {
      "at": 0.8,
      "file": "audio/voice/en/line-1.mp3",
      "duration": 3.456,
      "text": "Weekend. Four people. One table of gems."
    },
    {
      "at": 4.9,
      "file": "audio/voice/en/line-2.mp3",
      "duration": 2.28,
      "text": "Splendor — the family edition."
    },
    {
      "at": 7.9,
      "file": "audio/voice/en/line-3.mp3",
      "duration": 6.672,
      "text": "The rules are simple: take gems, buy cards, reach fifteen points, then finish the round."
    },
    {
      "at": 15.4,
      "file": "audio/voice/en/line-4.mp3",
      "duration": 5.592,
      "text": "On your turn, do one thing: take gems, buy a card, or reserve one."
    },
    {
      "at": 21.4,
      "file": "audio/voice/en/line-5.mp3",
      "duration": 3.84,
      "text": "Every card you buy is a permanent discount — and points."
    },
    {
      "at": 30.3,
      "file": "audio/voice/en/line-6.mp3",
      "duration": 4.224,
      "text": "Match a noble's bonuses and they visit you for three more points."
    },
    {
      "at": 36.3,
      "file": "audio/voice/en/line-7.mp3",
      "duration": 3.888,
      "text": "Four players on one screen — or everyone joins from a phone."
    },
    {
      "at": 40.7,
      "file": "audio/voice/en/line-8.mp3",
      "duration": 4.224,
      "text": "On your own network, scan and sit down. Nothing to install."
    },
    {
      "at": 45.3,
      "file": "audio/voice/en/line-9.mp3",
      "duration": 4.944,
      "text": "Four AI levels, a slower pace, and an undo for the odd mistake."
    },
    {
      "at": 50.6,
      "file": "audio/voice/en/line-10.mp3",
      "duration": 1.464,
      "text": "One more game tonight."
    }
  ]
}
