{
  "name": "@family-arcade/rummy-500",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "2–4 player Rummy 500",
  "scripts": {
    "dev": "vite --port 5210",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4210",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build",
    "e2e": "node scripts/e2e.mjs",
    "shots": "node scripts/shots.mjs",
    "lan:e2e": "node scripts/lan-e2e.mjs",
    "lan:shots": "node scripts/lan-shots.mjs",
    "lan": "node ../../tools/lan-server.mjs --dist dist --port 8080",
    "tauri": "tauri"
  },
  "dependencies": {
    "@family-arcade/lan": "file:../../packages/lan",
    "@tauri-apps/api": "^2.12.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
