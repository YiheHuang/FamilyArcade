{
  "name": "balloon-rally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Balloon Rally (气球大赛) — a light family party race of five balloons, four winds, and one shared guess.",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5177",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:verify": "node scripts/verify-data.mjs",
    "ai:calibrate": "esbuild scripts/ai-calibration.ts --bundle --platform=node --format=esm --outfile=.tmp/ai-calibration.mjs && node .tmp/ai-calibration.mjs",
    "check": "npm run data:verify && tsc --noEmit && vitest run && vite build",
    "e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/shots.mjs",
    "lan": "node ../../tools/lan-server.mjs --dist dist --port 8090",
    "tauri": "tauri"
  },
  "dependencies": {
    "@family-arcade/lan": "file:../../packages/lan",
    "@tauri-apps/api": "^2.12.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
