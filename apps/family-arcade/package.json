{
  "name": "@family-arcade/hub",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Family Arcade — one launcher for 53 family games",
  "scripts": {
    "dev": "vite --port 5200",
    "dev:lite": "vite --mode lite --port 5200",
    "build": "tsc --noEmit && vite build",
    "build:lite": "tsc --noEmit && vite build --mode lite",
    "preview": "vite preview --port 4200",
    "check": "tsc --noEmit && vite build",
    "e2e": "node scripts/e2e.mjs",
    "shots": "node scripts/shots.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
