{
  "name": "field-and-wall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Field & Wall (筑野) — an original tile-laying game for family game night",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:verify": "node scripts/verify-data.mjs && vitest run tests/data.test.ts",
    "check": "tsc --noEmit && vitest run && node scripts/verify-data.mjs && vite build",
    "demo": "vitest run --config vitest.demo.config.ts scripts/gen-demo.test.ts",
    "calibrate": "vitest run --config vitest.demo.config.ts scripts/ai-calibration.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "shots": "node scripts/shots.mjs",
    "lan": "node ../../tools/lan-server.mjs --dist dist --port 8080",
    "tauri": "tauri",
    "lan:e2e": "node scripts/lan-e2e.mjs"
  },
  "dependencies": {
    "@family-arcade/lan": "file:../../packages/lan",
    "@tauri-apps/api": "^2.12.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
