{
  "name": "blokus",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "description": "Blokus (角斗士棋) desktop app — solo training vs AI, local hot-seat, and LAN multiplayer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit -p tsconfig.json && vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "release": "node scripts/release.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
