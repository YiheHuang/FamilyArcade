{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liar's Dice",
  "version": "0.1.0",
  "identifier": "com.familyarcade.liars-dice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5224",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liar's Dice · 吹牛骰",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "dist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
